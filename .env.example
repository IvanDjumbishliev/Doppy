GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
APP_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Social OAuth credentials are required for real account connections.
# Register Doppy as an OAuth app with each platform, then add its credentials.
# Register these exact callback URLs with each provider app:
# http://localhost:3000/api/connections/instagram/callback
# http://localhost:3000/api/connections/tiktok/callback
# http://localhost:3000/api/connections/youtube/callback
# TikTok requires an HTTPS redirect URI; use an HTTPS development tunnel locally.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
